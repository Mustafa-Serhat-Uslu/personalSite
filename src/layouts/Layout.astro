---
import Header from "../components/Header/Header";
import profilePic from "../../assets/ProfilePic.jpeg";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html class="bg-stone-300 bg-opacity-70" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/personalSite/favicon.png" />
    <link rel="apple-touch-icon" href="/personalSite/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      html {
        overflow-y: scroll;
        scrollbar-gutter: stable;
      }
    </style>
  </head>
  <body class="pb-20">
    <!-- <Header client:load/> -->
    <Header client:load />
    <slot />
    <!-- All the different pages to be rendered here in the layout -->
  </body>
</html>
